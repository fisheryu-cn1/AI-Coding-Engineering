@prefix loan: <http://example.org/loan#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

loan:BorrowerShape a sh:NodeShape ;
  sh:targetClass loan:Borrower .
loan:LoanOrderShape a sh:NodeShape ;
  sh:targetClass loan:LoanOrder .
loan:CreditResultShape a sh:NodeShape ;
  sh:targetClass loan:CreditResult .
loan:OrderLogShape a sh:NodeShape ;
  sh:targetClass loan:OrderLog .
loan:ApprovalConfigShape a sh:NodeShape ;
  sh:targetClass loan:ApprovalConfig .
loan:RateConfigShape a sh:NodeShape ;
  sh:targetClass loan:RateConfig .
loan:OrderDetailShape a sh:NodeShape ;
  sh:targetClass loan:OrderDetail .
loan:ContractDetailShape a sh:NodeShape ;
  sh:targetClass loan:ContractDetail .
loan:ScoreInputShape a sh:NodeShape ;
  sh:targetClass loan:ScoreInput .
loan:ScoreOutputShape a sh:NodeShape ;
  sh:targetClass loan:ScoreOutput .
loan:StoreShape a sh:NodeShape ;
  sh:targetClass loan:Store .
loan:BorrowerServiceShape a sh:NodeShape ;
  sh:targetClass loan:BorrowerService .
loan:LoanOrderServiceShape a sh:NodeShape ;
  sh:targetClass loan:LoanOrderService .
loan:OrderFlowServiceShape a sh:NodeShape ;
  sh:targetClass loan:OrderFlowService .
loan:ConfigServiceShape a sh:NodeShape ;
  sh:targetClass loan:ConfigService .
loan:ScoringRulesShape a sh:NodeShape ;
  sh:targetClass loan:ScoringRules .
loan:RateRulesShape a sh:NodeShape ;
  sh:targetClass loan:RateRules .
loan:ValidationMiddlewareShape a sh:NodeShape ;
  sh:targetClass loan:ValidationMiddleware .
loan:HttpClientShape a sh:NodeShape ;
  sh:targetClass loan:HttpClient .
loan:BorrowerApiShape a sh:NodeShape ;
  sh:targetClass loan:BorrowerApi .
loan:OrderApiShape a sh:NodeShape ;
  sh:targetClass loan:OrderApi .
loan:ConfigApiShape a sh:NodeShape ;
  sh:targetClass loan:ConfigApi .
loan:BorrowerListViewShape a sh:NodeShape ;
  sh:targetClass loan:BorrowerListView .
loan:BorrowerFormViewShape a sh:NodeShape ;
  sh:targetClass loan:BorrowerFormView .
loan:OrderListViewShape a sh:NodeShape ;
  sh:targetClass loan:OrderListView .
loan:OrderDetailViewShape a sh:NodeShape ;
  sh:targetClass loan:OrderDetailView .
loan:ConfigPageViewShape a sh:NodeShape ;
  sh:targetClass loan:ConfigPageView .
loan:LoanStatusShape a sh:NodeShape ;
  sh:targetClass loan:LoanStatus ;
  sh:property [ sh:path [ sh:inversePath loan:hasLoanStatus ] ] .
loan:LoanPurposeShape a sh:NodeShape ;
  sh:targetClass loan:LoanPurpose ;
  sh:property [ sh:path [ sh:inversePath loan:hasLoanPurpose ] ] .
loan:CreditDecisionShape a sh:NodeShape ;
  sh:targetClass loan:CreditDecision ;
  sh:property [ sh:path [ sh:inversePath loan:hasCreditDecision ] ] .