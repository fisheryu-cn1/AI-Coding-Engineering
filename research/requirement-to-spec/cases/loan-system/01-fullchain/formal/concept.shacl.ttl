@prefix loan: <http://example.org/loan#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

loan:BorrowerShape a sh:NodeShape ;
  sh:targetClass loan:Borrower .
loan:LoanOrderShape a sh:NodeShape ;
  sh:targetClass loan:LoanOrder .
loan:CreditResultShape a sh:NodeShape ;
  sh:targetClass loan:CreditResult .
loan:OrderStatusShape a sh:NodeShape ;
  sh:targetClass loan:OrderStatus ;
  sh:property [ sh:path [ sh:inversePath loan:hasOrderStatus ] ] .
loan:LoanPurposeShape a sh:NodeShape ;
  sh:targetClass loan:LoanPurpose ;
  sh:property [ sh:path [ sh:inversePath loan:hasLoanPurpose ] ] .
loan:CreditDecisionShape a sh:NodeShape ;
  sh:targetClass loan:CreditDecision ;
  sh:property [ sh:path [ sh:inversePath loan:hasCreditDecision ] ] .
loan:LoanOrderShape sh:property [ sh:path loan:hasLoanPurpose ; sh:in (loan:lit_LoanPurpose_renovation loan:lit_LoanPurpose_education loan:lit_LoanPurpose_travel loan:lit_LoanPurpose_medical) ] .
loan:LoanOrderShape sh:property [ sh:path loan:hasOrderStatus ; sh:in (loan:lit_OrderStatus_draft loan:lit_OrderStatus_pending loan:lit_OrderStatus_active loan:lit_OrderStatus_closed) ] .
loan:CreditResultShape sh:property [ sh:path loan:hasCreditDecision ; sh:in (loan:lit_CreditDecision_under_review loan:lit_CreditDecision_approved loan:lit_CreditDecision_rejected) ] .
loan:LoanOrderShape sh:property [ sh:path loan:attrAmount ; sh:minCount 1 ] .
loan:LoanOrderShape sh:property [ sh:path loan:attrTerm_months ; sh:minCount 1 ] .
loan:BorrowerShape sh:property [ sh:path loan:attrId_number ; sh:minCount 1 ] .
loan:BorrowerShape sh:property [ sh:path loan:attrPhone ; sh:minCount 1 ] .
loan:BorrowerShape sh:property [ sh:path loan:attrId_number ; sh:pattern "^[0-9]{17}[0-9X]$" ] .
loan:BorrowerShape sh:property [ sh:path loan:attrPhone ; sh:pattern "^1[0-9]{10}$" ] .