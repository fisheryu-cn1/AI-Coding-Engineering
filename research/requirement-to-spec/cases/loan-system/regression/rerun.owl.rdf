<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/loan"
         xmlns="http://example.org/loan#">

<owl:Ontology rdf:about="http://example.org/loan"/>

<owl:ObjectProperty rdf:about="#places">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="#LoanOrder"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOrderStatus">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="#OrderStatus"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#attrId">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#LoanOrder"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrName">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrIncome">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrAmount">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#OrderStatus">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_draft">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_pending">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_approved">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_rejected">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_active">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#OrderStatus_closed">
  <rdfs:subClassOf rdf:resource="#OrderStatus"/>
</owl:Class>

<owl:Class rdf:about="#Borrower">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LoanOrder">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_draft">
  <rdf:type rdf:resource="#OrderStatus_draft"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_pending">
  <rdf:type rdf:resource="#OrderStatus_pending"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_approved">
  <rdf:type rdf:resource="#OrderStatus_approved"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_rejected">
  <rdf:type rdf:resource="#OrderStatus_rejected"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_active">
  <rdf:type rdf:resource="#OrderStatus_active"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_closed">
  <rdf:type rdf:resource="#OrderStatus_closed"/>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#OrderStatus_draft"/>
    <rdf:Description rdf:about="#OrderStatus_pending"/>
    <rdf:Description rdf:about="#OrderStatus_approved"/>
    <rdf:Description rdf:about="#OrderStatus_rejected"/>
    <rdf:Description rdf:about="#OrderStatus_active"/>
    <rdf:Description rdf:about="#OrderStatus_closed"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
