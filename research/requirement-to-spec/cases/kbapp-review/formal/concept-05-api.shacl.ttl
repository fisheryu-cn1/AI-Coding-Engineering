@prefix loan: <http://example.org/loan#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

loan:GraphStoreShape a sh:NodeShape ;
  sh:targetClass loan:GraphStore .
loan:ParserShape a sh:NodeShape ;
  sh:targetClass loan:Parser .
loan:ScoringModuleShape a sh:NodeShape ;
  sh:targetClass loan:ScoringModule .
loan:ParseSectionShape a sh:NodeShape ;
  sh:targetClass loan:ParseSection .
loan:ParseResultShape a sh:NodeShape ;
  sh:targetClass loan:ParseResult .
loan:CandidateDocShape a sh:NodeShape ;
  sh:targetClass loan:CandidateDoc .
loan:ScoringResultShape a sh:NodeShape ;
  sh:targetClass loan:ScoringResult .
loan:HitShape a sh:NodeShape ;
  sh:targetClass loan:Hit .
loan:McpToolSearchShape a sh:NodeShape ;
  sh:targetClass loan:McpToolSearch .
loan:McpToolShowShape a sh:NodeShape ;
  sh:targetClass loan:McpToolShow .
loan:McpToolReadShape a sh:NodeShape ;
  sh:targetClass loan:McpToolRead .
loan:McpToolRelatedShape a sh:NodeShape ;
  sh:targetClass loan:McpToolRelated .
loan:McpToolCompareShape a sh:NodeShape ;
  sh:targetClass loan:McpToolCompare .
loan:McpToolAssembleShape a sh:NodeShape ;
  sh:targetClass loan:McpToolAssemble .
loan:McpToolTopicsShape a sh:NodeShape ;
  sh:targetClass loan:McpToolTopics .
loan:McpToolIngestShape a sh:NodeShape ;
  sh:targetClass loan:McpToolIngest .
loan:McpToolReindexShape a sh:NodeShape ;
  sh:targetClass loan:McpToolReindex .