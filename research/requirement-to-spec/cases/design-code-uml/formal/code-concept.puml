title code-concept — 类图（取自代码真实签名）

' ----------------------------------------------------------
' 枚举
' ----------------------------------------------------------
enum LoanStatus {
  draft
  pending
  approved
  rejected
  active
  closed
}

enum LoanPurpose {
  装修
  教育
  旅游
  医疗
}

enum CreditDecision {
  approved
  rejected
}

' ----------------------------------------------------------
' 后端实体（types.ts）
' ----------------------------------------------------------
class Borrower {
  +id: number
  +name: string
  +id_number: string
  +phone: string
  +income: number
  +employer: string
  +position: string
  +created_at?: string
}

class LoanOrder {
  +id: number
  +borrower_id: number
  +amount: number
  +term_months: number
  +purpose: LoanPurpose
  +interest_rate: number
  +status: LoanStatus
  +created_at?: string
}

class CreditResult {
  +id: number
  +order_id: number
  +score: number
  +approved_amount: number
  +approved_rate: number
  +decision: CreditDecision
  +decision_reason: string
  +created_at?: string
}

class OrderLog {
  +id: number
  +order_id: number
  +action: string
  +comment: string
  +created_at?: string
}

class ApprovalConfig {
  +incomeWeight: number
  +debtRatioLimit: number
  +passThreshold: number
}

class RateConfig {
  +annualRate: number
  +serviceFee: number
  +overduePenalty: number
}

' ----------------------------------------------------------
' 后端值对象（service 返回拼装，非 types.ts 中显式声明）
' ----------------------------------------------------------
class OrderDetail <<data>> {
  +order: LoanOrder
  +credit: CreditResult?
  +logs: OrderLog[]
}

class ContractDetail <<data>> {
  +order: LoanOrder
  +credit: CreditResult?
  +rates: RateConfig
  +terms: string[]
}

' ----------------------------------------------------------
' 后端规则输入/输出（rules/scoring.ts）
' ----------------------------------------------------------
class ScoreInput {
  +borrower: Borrower
  +amount: number
  +termMonths: number
}

class ScoreOutput {
  +score: number
  +passed: boolean
  +decisionReason: string
}

' ----------------------------------------------------------
' 后端 Store（store.ts）— 内存实现，承载全部实体操作
' 默认值常量：approvalConfig(incomeWeight=60, debtRatioLimit=50, passThreshold=60)
'             rateConfig(annualRate=0.08, serviceFee=0.02, overduePenalty=0.0005)
' ----------------------------------------------------------
class Store <<singleton>> {
  ' 默认：approvalConfig={incomeWeight:60, debtRatioLimit:50, passThreshold:60}
  ' 默认：rateConfig={annualRate:0.08, serviceFee:0.02, overduePenalty:0.0005}
  +reset() : void
  --
  +listBorrowers(keyword?) : Borrower[]
  +getBorrower(id) : Borrower?
  +createBorrower(data) : Borrower
  +updateBorrower(id, data) : Borrower?
  +deleteBorrower(id) : boolean
  --
  +listOrders(keyword?) : LoanOrder[]
  +getOrder(id) : LoanOrder?
  +createOrder(data) : LoanOrder
  +updateOrder(id, data) : LoanOrder?
  +deleteOrder(id) : boolean
  --
  +listCredits(orderId?) : CreditResult[]
  +getCredit(id) : CreditResult?
  +getCreditByOrder(orderId) : CreditResult?
  +createCredit(data) : CreditResult
  +updateCredit(id, data) : CreditResult?
  +deleteCredit(id) : boolean
  --
  +listLogs(orderId) : OrderLog[]
  +createLog(data) : OrderLog
  --
  +getApprovalConfig() : ApprovalConfig
  +updateApprovalConfig(data) : ApprovalConfig
  +getRateConfig() : RateConfig
  +updateRateConfig(data) : RateConfig
}

note right of Store
  内存数组存储 + 自增 id 序列
  (borrowerSeq/orderSeq/creditSeq/logSeq)
  deleteOrder 级联删除关联 CreditResult 与 OrderLog
  来源：backend/src/store.ts
end note

' ----------------------------------------------------------
' 后端服务（services/）
' ----------------------------------------------------------
class BorrowerService {
  ' @logic list: 转发 store.listBorrowers(keyword)（按 name/id_number 子串匹配，忽略大小写）— borrowerService.ts
  +list(keyword?) : Borrower[]
  ' @logic get: 转发 store.getBorrower(id) — borrowerService.ts
  +get(id) : Borrower?
  ' @logic create: store.listBorrowers 中查重 id_number，重复则抛 409；否则 store.createBorrower — borrowerService.ts
  +create(data) : Borrower
  ' @logic update: store.updateBorrower(id,data)；不存在抛 404 — borrowerService.ts
  +update(id, data) : Borrower?
  ' @logic remove: store.deleteBorrower(id)；不存在抛 404 — borrowerService.ts
  +remove(id) : boolean
}

class LoanOrderService {
  ' @logic list: 转发 store.listOrders(keyword)（按 id/purpose/status 子串匹配） — loanOrderService.ts
  +list(keyword?) : LoanOrder[]
  ' @logic get: store.getOrder(id)；不存在抛 404 — loanOrderService.ts
  +get(id) : LoanOrder
  ' @logic save: 无 id 则 store.createOrder(status='draft', purpose 默认'装修',amount/term/interest_rate 默认 0)；
  '             有 id 则仅当原 status=='draft' 时 store.updateOrder — loanOrderService.ts
  +save(data) : LoanOrder
  ' @logic submit: canTransition 校验 draft→pending 合法；
  '                写 pending 后立即 autoApprove() 同步得到 decision；
  '                store.updateOrder(status=decision) 并写 OrderLog('submit') 与 OrderLog('approve') — loanOrderService.ts
  +submit(id) : LoanOrder
  ' @logic remove: store.deleteOrder（级联删除 CreditResult 与 OrderLog） — loanOrderService.ts
  +remove(id) : void
}

class OrderFlowService {
  ' @logic sign: canTransition 校验 approved→active；store.updateOrder + OrderLog('sign')；返回 contractDetail — orderFlowService.ts
  +sign(id) : ContractDetail
  ' @logic complete: canTransition 校验 active→closed；store.updateOrder + OrderLog('complete', comment||'订单已完成') — orderFlowService.ts
  +complete(id, comment) : OrderDetail
  ' @logic contractDetail: 拼装 {order, credit, rates=RateConfig, terms[5 条字符串]} — orderFlowService.ts
  +contractDetail(id) : ContractDetail
  ' @logic get: 拼装 {order, credit, logs} — orderFlowService.ts
  +get(id) : OrderDetail
}

class ConfigService {
  ' @logic getApprovalConfig/updateApprovalConfig/getRateConfig/updateRateConfig: 全部转发到 store — configService.ts
  +getApprovalConfig() : ApprovalConfig
  +updateApprovalConfig(data) : ApprovalConfig
  +getRateConfig() : RateConfig
  +updateRateConfig(data) : RateConfig
}

' ----------------------------------------------------------
' 后端规则（rules/）
' ----------------------------------------------------------
class ScoringRules <<module>> {
  ' @logic scoreLoan:
  '   monthlyIncome = borrower.income / 12
  '   incomeScore   = min(incomeWeight, monthlyIncome/20000 * incomeWeight)
  '   debtRatio     = amount / max(borrower.income, 1)
  '   debtScore     = max(0, (100-incomeWeight) * (1 - debtRatio/debtRatioLimit))
  '   score = round(incomeScore + debtScore)
  '   passed = score >= config.passThreshold — scoring.ts
  +scoreLoan(input, config) : ScoreOutput
  ' @logic autoApprove:
  '   取 order/borrower + 审批+费率配置；scoreLoan 出分；
  '   passed ? decision='approved' & approvedAmount=order.amount & approvedRate=annualRate
  '            : decision='rejected' & approvedAmount=0 & approvedRate=0；
  '   store.createCredit 持久化 — scoring.ts
  +autoApprove(orderId) : AutoApproveResult
}

class RateRules <<module>> {
  ' @logic getContractRates: 从 store.getRateConfig() 解出 annualRate/serviceFee/overduePenalty — rates.ts
  +getContractRates() : RateConfig
}

' ----------------------------------------------------------
' 后端中间件（middleware/）
' ----------------------------------------------------------
class ValidationMiddleware <<module>> {
  ' @logic validateBorrower: 校验 name 非空；id_number 匹配 /^[0-9]{17}[0-9Xx]$/；
  '                          phone 匹配 /^1[3-9][0-9]{9}$/；不通过返回 400 — validate.ts
  +validateBorrower(req, res, next) : void
  ' @logic validateLoanOrder: 校验 borrower_id 必填；amount>0；term_months>0；
  '                            purpose ∈ LOAN_PURPOSES（['装修','教育','旅游','医疗']）；不通过返回 400 — validate.ts
  +validateLoanOrder(req, res, next) : void
}

' ----------------------------------------------------------
' 后端路由（routes/）— 仅作摘要，不建模函数体
' ----------------------------------------------------------
note as RouteTable
  **路由表（baseURL=/api，来源：routes/index.ts）**
  GET    /health                  → healthRouter (返回 {status, timestamp})
  GET    /borrowers?keyword       → borrowerService.list
  GET    /borrowers/:id           → borrowerService.get
  POST   /borrowers               → validateBorrower → borrowerService.create
  PUT    /borrowers/:id           → validateBorrower → borrowerService.update
  DELETE /borrowers/:id           → borrowerService.remove
  GET    /orders?keyword          → orderService.list
  GET    /orders/:id              → flowService.get
  POST   /orders                  → validateLoanOrder → orderService.save
  PUT    /orders/:id              → validateLoanOrder → orderService.save(..., id)
  POST   /orders/:id/submit       → orderService.submit
  POST   /orders/:id/sign         → flowService.sign
  POST   /orders/:id/complete     → flowService.complete(id, body.comment)
  GET    /orders/:id/contract     → flowService.contractDetail
  DELETE /orders/:id              → orderService.remove
  GET    /credits?order_id        → store.listCredits
  GET    /config/approval         → configService.getApprovalConfig
  PUT    /config/approval         → configService.updateApprovalConfig
  GET    /config/rate             → configService.getRateConfig
  PUT    /config/rate             → configService.updateRateConfig
end note

' ----------------------------------------------------------
' 前端 HTTP / API 客户端（api/）
' ----------------------------------------------------------
class HttpClient <<module>> {
  -baseURL: string = '/api'
  -timeout: number = 10000
  ' @logic get/post/put/delete: 通过 axios.interceptors.response.use 拦截器
  '    将后端统一封包 {code, data, message} 解包为 data 字段；
  '    非 code===0 抛 Error(message)；网络错误取 err.response.data.message — http.ts
  +get<T>(url, config?) : Promise<T>
  +post<T>(url, data?) : Promise<T>
  +put<T>(url, data?) : Promise<T>
  +delete<T>(url) : Promise<T>
}

class BorrowerApi <<client>> {
  ' @logic 全部方法：转发至 apiRequest 对应 HTTP 方法，URL=/borrowers[/:id] — api/index.ts
  +list(keyword?) : Promise<Borrower[]>
  +get(id) : Promise<Borrower>
  +create(data) : Promise<Borrower>
  +update(id, data) : Promise<Borrower>
  +remove(id) : Promise<void>
}

class OrderApi <<client>> {
  ' @logic 全部方法：转发至 apiRequest；save 在 data.id 存在时 PUT /orders/:id，否则 POST /orders — api/index.ts
  +list(keyword?) : Promise<LoanOrder[]>
  +get(id) : Promise<OrderDetail>
  +save(data) : Promise<LoanOrder>
  +submit(id) : Promise<LoanOrder>
  +sign(id) : Promise<ContractDetail>
  +complete(id, comment) : Promise<OrderDetail>
  +contract(id) : Promise<ContractDetail>
  +remove(id) : Promise<void>
}

class ConfigApi <<client>> {
  ' @logic 全部方法：转发至 apiRequest 对应 /config/{approval,rate} — api/index.ts
  +getApproval() : Promise<ApprovalConfig>
  +updateApproval(data) : Promise<ApprovalConfig>
  +getRate() : Promise<RateConfig>
  +updateRate(data) : Promise<RateConfig>
}

' ----------------------------------------------------------
' 前端路由表（router/index.ts）
' ----------------------------------------------------------
note as FrontendRouteTable
  **前端路由（createWebHistory）**
  /               → redirect → /orders
  /borrowers      → BorrowerList.vue
  /borrowers/new  → BorrowerForm.vue
  /orders         → OrderList.vue
  /orders/:id     → OrderDetail.vue
  /config         → ConfigPage.vue
end note

' ----------------------------------------------------------
' 前端视图（views/）— 仅抽取领域相关的状态与操作，UI 细节不计
' ----------------------------------------------------------
class BorrowerListView <<vue>> {
  -list: Borrower[]
  -keyword: string
  -loading: boolean
  ' @logic load: borrowerApi.list(keyword)；onMounted 时挂载
  +load() : void
  ' @logic remove: borrowerApi.remove(id) 后重新 load
  +remove(id) : void
}

class BorrowerFormView <<vue>> {
  -active: number  ' step 序号 0..3（4 步表单：个人信息/职业收入/联系人/贷款需求）
  -submitting: boolean
  -form: BorrowerFormState  ' 见下方 note
  -purposes: LoanPurpose[] = ['装修','教育','旅游','医疗']
  ' @logic validateBorrower: 校验 name 非空、id_number、phone（同后端正则） — BorrowerForm.vue
  +validateBorrower() : string
  ' @logic validateLoan: amount>0、term_months>0 — BorrowerForm.vue
  +validateLoan() : string
  ' @logic saveDraft: borrowerApi.create → orderApi.save(borrower_id=borrower.id) — BorrowerForm.vue
  +saveDraft() : Promise<LoanOrder>
  ' @logic handleSubmit: 校验 → saveDraft → orderApi.submit；
  '                     按 result.status 分支跳转 /orders/:id — BorrowerForm.vue
  +handleSubmit() : Promise<void>
}

note right of BorrowerFormView
  BorrowerFormState 含 9 个字段：
  name, id_number, phone, income, employer,
  position, amount, term_months, purpose
end note

class OrderListView <<vue>> {
  -list: LoanOrder[]
  -keyword: string
  -loading: boolean
  ' @logic statusType: rejected→danger; approved/active→success; pending→warning; 其他→info — OrderList.vue
  +statusType(status) : TagType
  ' @logic load: orderApi.list(keyword)；onMounted 时挂载 — OrderList.vue
  +load() : void
  ' @logic remove: orderApi.remove(id) 后重新 load — OrderList.vue
  +remove(id) : void
}

class OrderDetailView <<vue>> {
  -detail: OrderDetail?
  -contract: ContractDetail?
  -comment: string
  -loading: boolean
  ' @logic load: orderApi.get(orderId)；onMounted 时挂载 — OrderDetail.vue
  +load() : void
  ' @logic loadContract: orderApi.contract(orderId) — OrderDetail.vue
  +loadContract() : void
  ' @logic openContract: 清空 contract 后 loadContract（用于详情页"查看合同并签署"按钮） — OrderDetail.vue
  +openContract() : void
  ' @logic sign: orderApi.sign(orderId) 后 reload — OrderDetail.vue
  +sign() : void
  ' @logic complete: orderApi.complete(orderId, comment) 后 reload — OrderDetail.vue
  +complete() : void
}

class ConfigPageView <<vue>> {
  -approval: ApprovalConfig = {incomeWeight:60, debtRatioLimit:50, passThreshold:60}
  -rate: RateConfig = {annualRate:0.08, serviceFee:0.02, overduePenalty:0.0005}
  -savingApproval: boolean
  -savingRate: boolean
  ' @logic load: 并行拉取 getApproval+getRate 写回 reactive 对象 — ConfigPage.vue
  +load() : void
  ' @logic saveApproval: configApi.updateApproval(approval) — ConfigPage.vue
  +saveApproval() : void
  ' @logic saveRate: configApi.updateRate(rate) — ConfigPage.vue
  +saveRate() : void
}

' ----------------------------------------------------------
' 关系
' ----------------------------------------------------------
LoanOrder --> LoanStatus
LoanOrder --> LoanPurpose
CreditResult --> CreditDecision
Borrower "1" --> "0..*" LoanOrder : applies
LoanOrder "1" --> "0..*" CreditResult : produces
LoanOrder "1" --> "0..*" OrderLog : tracks
LoanOrderService ..> OrderDetail : returns
LoanOrderService ..> ContractDetail : via submit / OrderDetail : via get
OrderFlowService ..> OrderDetail : returns
OrderFlowService ..> ContractDetail : returns

Store ..> Borrower : manages
Store ..> LoanOrder : manages
Store ..> CreditResult : manages
Store ..> OrderLog : manages
Store ..> ApprovalConfig : owns default
Store ..> RateConfig : owns default

BorrowerService ..> Store : delegates
LoanOrderService ..> Store : delegates
LoanOrderService ..> ScoringRules : submit() 调用 autoApprove
OrderFlowService ..> Store : delegates
OrderFlowService ..> RateRules : sign() 用 getContractRates
ConfigService ..> Store : delegates

ScoringRules ..> ScoreInput : consumes
ScoringRules ..> ScoreOutput : produces
ScoringRules ..> Store : reads ApprovalConfig + RateConfig
RateRules ..> Store : reads RateConfig

ValidationMiddleware ..> LoanPurpose : 校验 purpose ∈ LOAN_PURPOSES

HttpClient <.. BorrowerApi : uses apiRequest
HttpClient <.. OrderApi : uses apiRequest
HttpClient <.. ConfigApi : uses apiRequest

BorrowerListView ..> BorrowerApi : calls
BorrowerFormView ..> BorrowerApi : calls
BorrowerFormView ..> OrderApi : calls
OrderListView ..> OrderApi : calls
OrderDetailView ..> OrderApi : calls
ConfigPageView ..> ConfigApi : calls

@enduml