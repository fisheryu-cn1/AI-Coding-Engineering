@startuml concept-req
title intelli-metric 概念模型（自需求 v0.1~v0.3 提取，2026-08-30）
' 来源锚：F-/R- 编号见 raw/ 三份需求文档；@decision=翻译歧义或需求未明处的显式标注
' 追踪锚：TA1-xx = 第 1 轮人工审计条目（共 15 条）；审2-x = 第 2 轮复核条目。审计全文=E30-翻译审计表.md：交付拷贝中位于本图同级 review/ 子目录；研究仓库源位于 cases/intelli-metric/review/

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "数据源与元数据域 (F-DS/F-MD)" {
  class DataSource {
    name : string @required
    type : DataSourceType @required
    status : available | unavailable @required
    cipherCredential : string @decision(凭据加密存储,任何权限级别不可读明文=R-DS-4;建模为属性而非独立类)
    lastSyncAt : datetime
  --
  ' @logic testConnection: 连通性测试,失败置 status=unavailable。来源 F-DS-01
  + testConnection() : bool
  ' @logic collectMetadata: 元数据采集(手动全量/定时增量),生成新快照。来源 F-MD-01
  + collectMetadata(mode : manual | scheduled) : MetadataSnapshot
  ' @logic updateConfig: 修改连接配置前预检——返回依赖本数据源的未下架指标清单供评估;确认修改后受影响指标标记待评估。来源 F-LC-07
  + updateConfig(params) : MetricDefinition[]
  ' @logic remove: 删除保护——存在未下架依赖指标时拒绝删除。来源 F-LC-07
  + remove() : bool
  ' @logic grantAccess: owner 为其他主体授权/降级/移除(含把其他 owner 降级),受"至少一名 owner"约束。来源 R-DS-2/R-DS-3
  + grantAccess(principal : Principal, level : owner | reader | none)
}
  class MetadataSnapshot {
    version : int @required
    collectedAt : datetime @required
    trigger : manual | scheduled @required
  --
  ' @logic diff: 与任意指定快照对比差异(版本管理视图,F-MD-02"对比任意两版");相邻版对比即变更检测输入(F-MD-03)。来源 F-MD-02/F-MD-03
  + diff(other : MetadataSnapshot) : SchemaChangeEvent[]
}
  class TableMetadata {
    name : string @required
    comment : string
    businessDesc : string
    owner : string
    tags : string[]
    sensitiveLevel : string
    stats : rowCount | nullRate | cardinality @decision(样例统计项,需求标注"可选"——本期采集与否未定,避免实现期争议,TA1-09/审2-遗留2)
  --
  ' @logic updateBusinessInfo: 元数据业务补充信息维护(业务描述/负责人/标签/敏感级别)。来源 F-MD-02
  + updateBusinessInfo(businessDesc, owner, tags, sensitiveLevel)
  ' @logic search: 按关键字/标签/数据源检索表与字段(静态查询)。来源 F-MD-02
  + search(keyword, tags, source) : TableMetadata[]
}
  class FieldMetadata {
    name : string @required
    dataType : string @required
    comment : string
    nullable : boolean
  }
  class SchemaChangeEvent {
    changeType : add | drop | typeChange | commentChange @required
    detectedAt : datetime @required
    detail : string
  --
  ' @logic publishToStream: 变更事件入事件流,供指标模块订阅。来源 F-MD-03
  + publishToStream()
}
  class DatabaseMetadata {
    name : string @required
    comment : string
  }
  enum DataSourceType {
    MySQL
    PostgreSQL
    Hive @decision(预留扩展点,F-DS-01)
    Doris_StarRocks
    ClickHouse
    API
  }
  DataSource "1" --> "*" MetadataSnapshot : F-MD-01 采集
  MetadataSnapshot --> "*" DatabaseMetadata : 快照含库集(审2-4:库/表/字段均为快照下版本化副本)
  DatabaseMetadata "1" --> "*" TableMetadata
  TableMetadata "1" --> "*" FieldMetadata
  MetadataSnapshot ..> SchemaChangeEvent : 相邻快照对比产生 F-MD-03
  SchemaChangeEvent --> DataSource : 受变更对象(TA1-03)
  SchemaChangeEvent --> TableMetadata : 受变更对象
  SchemaChangeEvent --> FieldMetadata : 受变更对象
}

package "知识库与本体域 (F-KB)" {
  class KnowledgeEntry {
    title : string @required
    body : markdown @required
    type : KnowledgeType @required
    tags : string[]
    source : string
    version : int @required
  --
  ' @logic save: 知识条目 CRUD 维护(标题/正文/类型/标签/关联元数据/版本)。来源 F-KB-01
  + save()
  ' @logic importBatch: Markdown 批量导入(单文件/压缩包,导入时指定类型与标签)——冷启动灌入。来源 F-KB-01
  + importBatch(files, type, tags)
  ' @logic exportBackup: 知识导出备份。来源 F-KB-01
  + exportBackup()
  ' @logic searchHybrid: 全文+语义(向量化)混合检索,支持类型/标签过滤。来源 F-KB-01
  + searchHybrid(query, type, tags) : KnowledgeEntry[]
}
  class OntologyModel {
    name : string @required
    status : draft | confirmed @required
  --
  ' @logic confirm: 本体草稿经人工审核确认后入库。来源 F-KB-02
  + confirm()
  ' @logic mergeIncremental: 增量补充合并,实体冲突时产生提示。来源 F-KB-02
  + mergeIncremental(draft : OntologyModel) : string[]
}
  class OntologyEntity {
    name : string @required
    attributesJson : string
    semantics : string
  }
  class OntologyRelation {
    name : string @required
  }
  class EntityMapping {
    confidence : float
    confirmedBy : string @required
  --
  ' @logic suggest: 本体实体与物理表/字段的映射自动建议。来源 F-KB-03
  + suggest(entity : OntologyEntity, target : TableMetadata)
  ' @logic confirmBy: 映射人工确认——业务语言→本体实体→物理数据的关键中间层。来源 F-KB-03
  + confirmBy(user : User)
}
  enum KnowledgeType {
    构建模板
    清洗方法
    加工方法
    业务术语口径
    领域概念说明
  }
  KnowledgeEntry ..> OntologyModel : F-KB-02 LLM提取草稿→人工确认
  OntologyModel *-- "*" OntologyEntity
  OntologyModel *-- "*" OntologyRelation
  OntologyRelation "0..*" --> "1" OntologyEntity : source(TA1-01/审2-小1)
  OntologyRelation "0..*" --> "1" OntologyEntity : target(TA1-01/审2-小1)
  OntologyEntity "0..*" --> "0..*" EntityMapping : F-KB-03 对齐
  EntityMapping ..> TableMetadata : 映射目标(表/字段,TA1-11)
  EntityMapping ..> FieldMetadata : 映射目标(字段)
}

package "指标域 (F-LC, 核心)" {
  class MetricDefinition {
    cnName : string @required
    enName : string @required @pattern(全局唯一标识)
    category : atomic | derived | composite @required
    caliber : string @required
    owner : string @required @decision(业务元信息"负责人"(F-LC-01 元信息清单)——非权限载体,权限事实源是 ResourceGrant 的 manager 体系(TA1-15))
    bizDomain : string
    tags : string[]
    dsl : json | yaml @required @decision(引擎解耦的结构化定义,F-LC-01)
  --
  ' @logic create: 低代码构建——选源表字段/聚合/过滤/维度/时间粒度/口径,存为引擎无关 DSL。来源 F-LC-01
  + create(params) : MetricDefinition
  ' @logic instantiate: 基于模板填参生成指标定义草稿。来源 F-LC-02
  + instantiate(template : MetricTemplate, params) : MetricDefinition
  ' @logic toDraftFromSuggestion: LLM 构建建议一键转为定义草稿。来源 F-AI-01
  + toDraftFromSuggestion(s : MetricSuggestion) : MetricDefinition
  ' @logic newVersion: 口径变更生成指标新版本(重新走测试);权限随定义继承。来源 F-LC-04/R-M-3
  + newVersion(reason) : MetricVersion
  ' @logic grantAccess: manager 为其他主体授权/降级的入口,委托 ResourceGrant.grant 执行(权限事实源单一,TA1-15),受"至少一名 manager"约束。来源 R-M-2
  + grantAccess(principal : Principal, level : manager | reader | none)
  ' @logic checkEnNameUnique: 英文名全局唯一性校验(创建/改名时)。来源 F-LC-01
  + checkEnNameUnique(enName) : bool
}
  class MetricVersion {
    versionNo : int @required
    createdAt : datetime @required
    @decision(状态机挂版本而非指标实体:F-LC-04多版本并存+R-M-3权限随指标实体继承——权限挂定义,生命周期挂版本)
  --
  ' @logic submit: 发起测试(draft→testing)。来源 F-LC-03/F-LC-06
  + submit()
  ' @logic evaluate: 试算(生成查询在源数据执行,返回样例与耗时)+有效性评估,产出报告;测试通过是发布前置条件。来源 F-LC-03
  + evaluate() : TestReport
  ' @logic publish: 测试通过后发布,即时切换默认路由(无中断),留痕并通知调用方负责人。来源 F-LC-04/F-SV-01-02
  + publish()
  ' @logic pause: 暂停服务(管理动作或处置动作)。来源 F-LC-04/F-LC-07
  + pause()
  ' @logic resume: 恢复服务(验证要求待需求方确认,见 @decision)。来源 F-LC-04
  + resume()
  ' @logic delist: 下架——人工指令+原因记录;自动触发时经处置待办确认。来源 F-LC-05
  + delist(reason)
}
  class MetricTemplate {
    skeleton : string @required
    scenarioDesc : string
    acceptanceRuleTemplate : string
    version : int @required
  --
  ' @logic instantiate: 参数化骨架填参即生成指标定义草稿。来源 F-LC-02
  + instantiate(params) : MetricDefinition
  ' @logic fromKnowledge: 模板可从知识库知识条目转化。来源 F-LC-02
  + fromKnowledge(entry : KnowledgeEntry) : MetricTemplate
  ' @logic fromMetric: 模板可由成功指标沉淀而来。来源 F-LC-02
  + fromMetric(def : MetricDefinition) : MetricTemplate
}
  class AcceptanceRule {
    ruleType : basic | consistency | business @required
    expression : string @required
  --
  ' @logic check: 单条验收规则对试算结果的校验执行(如 退款率∈[0,1])。来源 F-LC-03
  + check(sample) : bool
}
  class TestReport {
    sampleResult : string
    costTime : float
    verdict : pass | fail @required
    evaluatedAt : datetime @required
  --
  ' @logic assess: 有效性评估执行——基础校验(空值率/取值范围/非负性/枚举合法)+一致性校验(同类指标/历史值波动率)+业务规则校验(知识库/模板规则)。来源 F-LC-03
  + assess(rules : AcceptanceRule[]) : pass | fail
}
  class DependencyEdge {
    level : source | table | field | metric @required
    @decision(level 补 metric 级(TA1-02):F-LC-07 原文图谱仅"数据源→表/字段→指标"三级,不含指标→指标——复合指标(F-LC-01 多指标运算)的影响传导是需求盲区,本模型补全,待需求方确认)
  --
  ' @logic locateAffected: 变更事件经依赖图谱(数据源→表/字段→指标)定位受影响指标集合。来源 F-LC-07
  + locateAffected(change : SchemaChangeEvent) : MetricDefinition[]
  ' @logic listActiveDependents: 列出依赖某数据源的未下架指标(配置变更预检/删除保护)。来源 F-LC-07
  + listActiveDependents(ds : DataSource) : MetricDefinition[]
}
  enum MetricCategory {
    原子指标
    派生指标
    复合指标
  }
  MetricDefinition "1" o-- "*" MetricVersion : F-LC-04 版本链
  MetricDefinition "0..*" --> "0..*" MetricDefinition : 复合组成(TA1-02,复合指标=多指标运算 F-LC-01;上游变更/下架经依赖图谱 metric 级传导)
  MetricDefinition ..> MetricTemplate : F-LC-02 模板实例化
  MetricTemplate ..> KnowledgeEntry : 可由知识条目转化
  MetricDefinition "1" --> "0..*" AcceptanceRule : F-LC-03 验收规则
  MetricVersion "1" --> "0..*" TestReport : F-LC-03 试算与评估
  MetricDefinition --> "*" DependencyEdge : F-LC-07 依赖图谱(构建时自动建立)
  DependencyEdge --> DataSource
  DependencyEdge --> TableMetadata
  DependencyEdge --> FieldMetadata
  KnowledgeEntry "0..*" -- "0..*" TableMetadata : 元数据↔知识关联(01§2)
  KnowledgeEntry "0..*" -- "0..*" FieldMetadata : 字段级关联(F-KB-01,TA1-11)
}

package "服务域 (F-LC-04/F-SV/F-MON-02)" {
  class ServingAPI {
    apiType : realtime | batch @required
    @decision(routeStrategy 已移除(TA1-10/审2-遗留1):latest|pinned 是调用方每次调用的路由选择(F-SV-01-01"调用方可显式指定版本"),非服务实例属性——语义由 resolveRoute(consumer, versionSpec) 方法参数承载)
  --
  ' @logic query: 实时查询——按指标名+维度+时间范围,带缓存。来源 F-LC-04
  + query(metric, dims, timeRange) : rows
  ' @logic submitBatch: 批处理任务——结果输出到表/文件/消息(首版至少结果表导出)。来源 F-LC-04
  + submitBatch(params, output) : jobId
  ' @logic resolveRoute: 版本路由——默认最新发布版本,支持调用方显式指定;退役版本返回 VERSION_RETIRED。来源 F-SV-01-01
  + resolveRoute(consumer, versionSpec) : MetricVersion
  ' @logic retire: 版本退役——前置检查"近 7 天无调用";退役仅影响显式指定,默认路由不变。来源 F-SV-01-03
  + retire(version : MetricVersion)
}
  class ApiConsumer {
    name : string @required
    status : active | disabled @required
  --
  ' @logic disable: 调用方账户停用。来源 3.5
  + disable()
  ' @logic grantMetricScope: 按指标授权调用范围。来源 3.5/F-LC-04
  + grantMetricScope(metric : MetricDefinition)
}
  class AccessToken {
    tokenHash : string @required @decision(明文仅创建时展示一次,服务端只存哈希(F-SEC-API-02,TA1-13)——与 DataSource 凭据同等待遇)
    remark : string
    status : issued | revoked | expired @required
    expireAt : datetime
  --
  ' @logic issue: 颁发 token(绑定调用方与授权范围)。来源 F-LC-04/3.5
  + issue(consumer : ApiConsumer, scopes)
  ' @logic revoke: 吊销。来源 F-LC-04
  + revoke()
  ' @logic verify: 每次服务调用前校验(token 有效且在授权范围内)。来源 F-LC-04
  + verify() : bool
}
  class BatchJob {
    jobId : string @required
    inputParams : string @required
    outputLocation : string
    startAt : datetime
    endAt : datetime
    dataVolume : int
  }
  class InvocationLog {
    ts : datetime @required
    params : string
    latency : float
    status : success | fail @required
    errType : sourceError | badParam | timeout | permDenied | versionRetired
    resultRows : int
    sourceIp : string
  --
  ' @logic record: 每次调用记录——时间/调用方/指标与版本/参数/耗时/状态与错误类型/结果行数/来源IP;批处理另记任务详情。来源 F-MON-02-01
  + record(call)
  ' @logic queryLogs: 按指标/调用方/时间窗/状态组合检索,支持导出。来源 F-MON-02-03
  + queryLogs(filters) : rows
  ' @logic aggregate: 监控聚合(延迟分位/成功率/错误分类/用量,按分钟/小时粒度存时序表)。来源 F-MON-01/R-MON-2
  + aggregate(window)
}
  MetricVersion "1" --> "0..1" ServingAPI : 发布提供服务
  ServingAPI "1" --> "*" BatchJob : 批处理任务(TA1-07,F-MON-02-01 另记)
  note right of BatchJob
    F-LC-04 批处理是"批量指标计算任务"——可跨多指标;
    多指标参数置于 inputParams,任务经单一 API 入口提交(审2-小2)
  end note
  ApiConsumer "1" --> "*" AccessToken
  ApiConsumer "*" --> "1" User : 负责对接的内部用户(TA1-06,F-SEC-API-01;版本切换通知目标 F-SV-01-02)
  ApiConsumer "0..*" --> "0..*" MetricDefinition : 按指标授权调用范围
  InvocationLog --> ApiConsumer
  InvocationLog --> User : 内部用户调用(TA1-12,调用方=用户|下游系统)
  InvocationLog --> MetricVersion
}

package "监控告警域 (F-MON)" {
  class AlertRule {
    thresholdType : successRate | latency | depException @required
    threshold : float @required
    @decision(F-MON-03"阈值规则模型先行,本期预留不做通知通道"——模型先行承载,实现后置)
  }
  AlertRule "0..*" --> "1" MetricDefinition : 告警对象
  note bottom of AlertRule
    看板内视觉告警;触发后经 F-SV-02 闭环进入 DisposalTodo
    (cause=thresholdBreach)
  end note
}

package "平台与权限域 (02-权限设计/3.5)" {
  class User {
    username : string @required
    status : active | disabled @required
  --
  ' @logic bootstrapAdmin: 空实例首次启动经初始化向导创建首个超级管理员;系统始终保留至少一名。来源 3.5/02§6
  + bootstrapAdmin()
  ' @logic disable: 停用/启用。来源 3.5
  + disable()
  ' @logic resetPassword: 重置密码。来源 3.5
  + resetPassword()
  ' @logic assignRoles: 角色分配。来源 3.5
  + assignRoles(roles : Role[])
}
  class Role {
    name : string @required
  }
  class PermissionPoint {
    code : string @required
  }
  class ResourceGrant {
    resourceLevel : owner | manager | reader | none @required
  --
  ' @logic grant: 资源级授权(数据源 owner/reader/none;指标 manager/reader/none),主体为用户(组织节点预留继承)。来源 02§1/§2/§3
  + grant(principal : Principal, resource, level)
  ' @logic check: 鉴定点——功能权限(RBAC)+资源级(ACL)合成判定。来源 02§1
  + check(user, action, resource) : allow | deny
}
  class Principal {
    subjectType : user | orgNode @decision(组织节点为预留,02§1授权主体抽象)
  }
  class DisposalTodo {
    cause : structureChange | depUnhealthy | thresholdBreach @required
    action : fix | pause | delist
    status : open | done @required
  --
  ' @logic assignTo: 向指标 manager 生成处置待办(站内通知);数据源 owner 同时可见影响范围。来源 F-SV-02
  + assignTo(manager : User)
  ' @logic execute: 处置三选一——修复定义(回草稿)/暂停服务/下架;处置后需重新试算验证方可恢复;过程留痕。来源 F-LC-07
  + execute(action : fix | pause | delist)
  ' @logic pauseAllAffected: 紧急情况一键暂停全部受影响指标。来源 F-SV-02
  + pauseAllAffected(scope)
}
  class AuditLog {
    actor : string @required
    action : string @required
    ts : datetime @required
  --
  ' @logic append: 管理类操作留痕(发布/暂停/下架/权限变更/数据源配置变更),只增不改。来源 F-MON-02-02
  + append(entry)
}
  class MonitorFlag {
    flag : degraded | pendingEval | perfAbnormal @required
    @decision(服务降级建模为运行期标记而非状态机状态:R-MON-1"恢复后自动解除"为可逆监控信号;状态机paused态为管理动作——两者区分待需求方确认)
  --
  ' @logic mark: 运行期标记——依赖异常(降级/不可用)/待评估/性能异常,状态回传指标详情与看板。来源 R-MON-1/F-SV-02
  + mark(flag, cause)
  ' @logic autoClear: 数据源恢复后自动解除依赖异常标记(可逆监控信号,非状态机状态)。来源 R-MON-1
  + autoClear()
}
  User "0..*" --> "0..*" Role : RBAC 全局功能权限
  Role --> "*" PermissionPoint
  Principal --> "*" ResourceGrant : ACL 资源级授权
  ResourceGrant --> DataSource
  ResourceGrant --> MetricDefinition
  Principal ..> User : 主体为用户(组织预留)
  SchemaChangeEvent --> DisposalTodo : F-MD-03→F-LC-07 触发
  DisposalTodo --> MetricDefinition : 处置对象
  AuditLog --> User
  MonitorFlag --> MetricVersion : R-MON-1 运行期标记
}

package "LLM 智能辅助域 (F-AI)" {
  class LLMPipeline {
    taskType : ontologyExtract | metricSuggest @required
  --
  ' @logic extractOntology: 从知识库自然语言文本抽取实体定义与逻辑关联,产出本体草稿。来源 F-KB-02
  + extractOntology(texts) : OntologyModel
  ' @logic suggestMetric: 需求解析→本体与知识库检索(RAG)→生成结构化建议(源数据+理由/加工方法/口径草稿/验收规则建议)。来源 F-AI-01
  + suggestMetric(nlRequirement) : MetricSuggestion
}
  class MetricSuggestion {
    sourceData : string @required
    processMethod : string
    caliberDraft : string
    acceptanceSuggestion : string
  --
  ' @logic toDraft: 建议一键转为指标定义草稿,进入 F-LC-01 流程。来源 F-AI-01
  + toDraft() : MetricDefinition
}
  LLMPipeline ..> OntologyModel : F-KB-02
  LLMPipeline --> MetricSuggestion : F-AI-01 RAG+生成
  MetricSuggestion ..> MetricDefinition : 一键转为定义草稿
}

note bottom of MetricVersion
  生命周期状态机见 flow-metric.puml:
  草稿→测试中→已发布→(暂停)→已下架,
  失败回草稿;口径变更→新版本重走测试(F-LC-06)
end note
note right of DataSource
  R-DS-3: 任一时刻每数据源至少一名 owner
  (删除保护:F-LC-07 存在未下架依赖指标的数据源不可删除)
end note
note right of MetricDefinition
  R-M-2: 每指标至少保留一名 manager
