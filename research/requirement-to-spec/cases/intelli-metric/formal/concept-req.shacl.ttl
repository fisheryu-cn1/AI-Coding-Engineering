@prefix loan: <http://example.org/loan#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

loan:DataSourceShape a sh:NodeShape ;
  sh:targetClass loan:DataSource .
loan:MetadataSnapshotShape a sh:NodeShape ;
  sh:targetClass loan:MetadataSnapshot .
loan:TableMetadataShape a sh:NodeShape ;
  sh:targetClass loan:TableMetadata .
loan:FieldMetadataShape a sh:NodeShape ;
  sh:targetClass loan:FieldMetadata .
loan:SchemaChangeEventShape a sh:NodeShape ;
  sh:targetClass loan:SchemaChangeEvent .
loan:DatabaseMetadataShape a sh:NodeShape ;
  sh:targetClass loan:DatabaseMetadata .
loan:KnowledgeEntryShape a sh:NodeShape ;
  sh:targetClass loan:KnowledgeEntry .
loan:OntologyModelShape a sh:NodeShape ;
  sh:targetClass loan:OntologyModel .
loan:OntologyEntityShape a sh:NodeShape ;
  sh:targetClass loan:OntologyEntity .
loan:OntologyRelationShape a sh:NodeShape ;
  sh:targetClass loan:OntologyRelation .
loan:EntityMappingShape a sh:NodeShape ;
  sh:targetClass loan:EntityMapping .
loan:MetricDefinitionShape a sh:NodeShape ;
  sh:targetClass loan:MetricDefinition .
loan:MetricVersionShape a sh:NodeShape ;
  sh:targetClass loan:MetricVersion .
loan:MetricTemplateShape a sh:NodeShape ;
  sh:targetClass loan:MetricTemplate .
loan:AcceptanceRuleShape a sh:NodeShape ;
  sh:targetClass loan:AcceptanceRule .
loan:TestReportShape a sh:NodeShape ;
  sh:targetClass loan:TestReport .
loan:DependencyEdgeShape a sh:NodeShape ;
  sh:targetClass loan:DependencyEdge .
loan:ServingAPIShape a sh:NodeShape ;
  sh:targetClass loan:ServingAPI .
loan:ApiConsumerShape a sh:NodeShape ;
  sh:targetClass loan:ApiConsumer .
loan:AccessTokenShape a sh:NodeShape ;
  sh:targetClass loan:AccessToken .
loan:BatchJobShape a sh:NodeShape ;
  sh:targetClass loan:BatchJob .
loan:InvocationLogShape a sh:NodeShape ;
  sh:targetClass loan:InvocationLog .
loan:AlertRuleShape a sh:NodeShape ;
  sh:targetClass loan:AlertRule .
loan:UserShape a sh:NodeShape ;
  sh:targetClass loan:User .
loan:RoleShape a sh:NodeShape ;
  sh:targetClass loan:Role .
loan:PermissionPointShape a sh:NodeShape ;
  sh:targetClass loan:PermissionPoint .
loan:ResourceGrantShape a sh:NodeShape ;
  sh:targetClass loan:ResourceGrant .
loan:PrincipalShape a sh:NodeShape ;
  sh:targetClass loan:Principal .
loan:DisposalTodoShape a sh:NodeShape ;
  sh:targetClass loan:DisposalTodo .
loan:AuditLogShape a sh:NodeShape ;
  sh:targetClass loan:AuditLog .
loan:MonitorFlagShape a sh:NodeShape ;
  sh:targetClass loan:MonitorFlag .
loan:LLMPipelineShape a sh:NodeShape ;
  sh:targetClass loan:LLMPipeline .
loan:MetricSuggestionShape a sh:NodeShape ;
  sh:targetClass loan:MetricSuggestion .
loan:DataSourceTypeShape a sh:NodeShape ;
  sh:targetClass loan:DataSourceType ;
  sh:property [ sh:path [ sh:inversePath loan:hasDataSourceType ] ] .
loan:KnowledgeTypeShape a sh:NodeShape ;
  sh:targetClass loan:KnowledgeType ;
  sh:property [ sh:path [ sh:inversePath loan:hasKnowledgeType ] ] .
loan:MetricCategoryShape a sh:NodeShape ;
  sh:targetClass loan:MetricCategory ;
  sh:property [ sh:path [ sh:inversePath loan:hasMetricCategory ] ] .