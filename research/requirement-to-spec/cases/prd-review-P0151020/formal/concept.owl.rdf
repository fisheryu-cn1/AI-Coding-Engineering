<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/loan"
         xmlns="http://example.org/loan#">

<owl:Ontology rdf:about="http://example.org/loan"/>

<owl:ObjectProperty rdf:about="#places">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="#LoanOrder"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDecision">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="#CreditResult"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLoanPurpose">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="#LoanPurpose"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOrderStatus">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="#OrderStatus"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#attrId">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:domain rdf:resource="#CreditResult"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrName">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrId_number">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrPhone">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrIncome">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrEmployer">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrPosition">
  <rdfs:domain rdf:resource="#Borrower"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrBorrower_id">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrAmount">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrTerm_months">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrInterest_rate">
  <rdfs:domain rdf:resource="#LoanOrder"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrOrder_id">
  <rdfs:domain rdf:resource="#CreditResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attrScore">
