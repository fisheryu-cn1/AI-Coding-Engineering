</owl:Class>

<owl:Class rdf:about="#Borrower">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LoanOrder">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CreditResult">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_draft">
  <rdf:type rdf:resource="#OrderStatus_draft"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#lit_OrderStatus_pending">
